<?xml version="1.0" encoding="utf-8"?>
<resources>
  <style name="JarvisTheme" parent="android:style/Theme.Material.NoActionBar">
    <item name="android:fontFamily">sans</item>
    <item name="android:windowLightNavigationBar">false</item>
    <item name="android:windowLightStatusBar">false</item>
    <item name="android:statusBarColor">#070914</item>
    <item name="android:navigationBarColor">#070707</item>
    <item name="android:windowActionModeOverlay">true</item>
    <item name="android:colorAccent">#B66BFF</item>
    <item name="android:alertDialogTheme">@style/PandoraDialogTheme</item>
  </style>
  <style name="PandoraDialogTheme" parent="android:style/Theme.Material.Dialog.Alert">
    <item name="android:windowBackground">@drawable/pandora_dialog_background</item>
    <item name="android:colorAccent">#BB7DFF</item>
    <item name="android:textColorPrimary">#FFFFFF</item>
    <item name="android:textColorSecondary">#B7ACDC</item>
  </style>
</resources>
